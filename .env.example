# ---- core ----
SECRET_KEY=replace-with-a-long-random-string
DATABASE_URL=sqlite:///./ats.db
ACCESS_TOKEN_EXPIRE_HOURS=12
PUBLIC_BASE_URL=http://localhost:8000

# ---- Microsoft Graph / OneDrive (app-only client credentials) ----
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_DRIVE_USER=info@bharatsteels.in
ATS_ROOT_FOLDER=ATS

# ---- HR email notification on new application (uses the SAME Graph app) ----
# Who gets the "new application" email. Comma-separate for multiple people.
HR_NOTIFY_EMAIL=hr@bharatsteels.in
# Mailbox the notification is SENT FROM (needs Mail.Send app permission in Azure).
GRAPH_SENDER=hr@bharatsteels.in

# ---- bootstrap super admin (created by scripts/init_db.py) ----
SUPER_ADMIN_EMAIL=info@bharatsteels.in
SUPER_ADMIN_PASSWORD=ChangeMe@123
SUPER_ADMIN_NAME=Group Admin
